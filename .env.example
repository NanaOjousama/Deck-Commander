# Copy to a private deployment location; never commit your filled-in .env.
# DC_HOME=/path/to/PRIVATE/deck-commander-install
DC_WINDOWS_HOSTNAME=YOUR_WINDOWS_HOSTNAME.local
DC_WINDOWS_LAUNCHER=C:\DeckCommander\start-dc.cmd
DC_DECK_NETWORK_INTERFACE=wlan0
# Optional: warns when Deck's LAN IP changes from the Windows SSH firewall allowlist
# DC_DECK_FIREWALL_ALLOWED_IPV4=192.168.1.10
# Optional when Desktop Commander is installed outside this directory:
# DC_STEAMDECK_NODE=/path/to/node
# DC_STEAMDECK_ENTRYPOINT=/path/to/node_modules/@wonderwhy-er/desktop-commander/dist/index.js